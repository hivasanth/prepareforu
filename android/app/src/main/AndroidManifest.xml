<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml
  ────────────────────
  Placed at: android/app/src/main/AndroidManifest.xml

  This is a hardened manifest for PrepareForU.
  It replaces the default Capacitor-generated manifest.

  Security changes from the Capacitor default:
  ─────────────────────────────────────────────
  1. android:networkSecurityConfig — points to our custom XML (no cleartext,
     system CAs only, localhost exception for bridge).
  2. android:usesCleartextTraffic="false" — belt-and-suspenders alongside
     network_security_config.xml. Enforces HTTP blocking at the manifest level
     for API < 24 devices as well.
  3. android:debuggable not set — defaults to false in release builds.
     Never set this to true in a production manifest.
  4. android:allowBackup="false" — prevents adb backup from extracting the
     app's private data (including Supabase JWT from SharedPreferences).
  5. Permissions — INTERNET only. No location, camera, contacts, storage,
     or other dangerous permissions declared. Add explicitly if features need them.
  6. exported="false" on all non-launcher Activities — prevents other apps
     from starting internal activities via implicit intents.
-->
<manifest
  xmlns:android="http://schemas.android.com/apk/res/android"
  package="com.prepareforu.app">

  <!-- ── Permissions ──────────────────────────────────────────────────────── -->
  <!--
    INTERNET: Required to reach Supabase, Cloudflare Turnstile, Google Fonts.
    No other permissions are needed for PrepareForU's current feature set.

    DO NOT add READ_EXTERNAL_STORAGE, WRITE_EXTERNAL_STORAGE, ACCESS_FINE_LOCATION,
    CAMERA, READ_CONTACTS, or RECORD_AUDIO unless a specific feature requires them.
    Each permission added increases the Play Store review surface and user trust risk.
  -->
  <uses-permission android:name="android.permission.INTERNET"/>

  <!-- ── Application ──────────────────────────────────────────────────────── -->
  <application
    android:label="@string/app_name"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:theme="@style/AppTheme"

    android:networkSecurityConfig="@xml/network_security_config"

    android:usesCleartextTraffic="false"

    android:allowBackup="false"

    android:supportsRtl="true">

    <!-- ── Main Activity ──────────────────────────────────────────────────── -->
    <!--
      MainActivity is the single entry point for Capacitor.
      android:exported="true" is required here because it handles the
      LAUNCHER intent (the user taps the app icon).

      android:configChanges — prevents Activity restarts on orientation/keyboard
      changes. Capacitor handles these in the WebView layer.

      android:windowSoftInputMode="adjustResize" — ensures the WebView viewport
      shrinks correctly when the soft keyboard appears (critical for login/signup
      forms on smaller screens).

      android:launchMode="singleTask" — prevents multiple instances of the app
      being created when the user navigates back and reopens it.
    -->
    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:launchMode="singleTask"
      android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
      android:windowSoftInputMode="adjustResize">

      <!-- Launcher intent filter — makes this the entry Activity -->
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>

      <!--
        Deep link intent filter — handles https://prepareforu.app/* links.
        Required if you use Supabase Auth email redirects (magic links,
        password reset, email verification) that redirect back to the app.

        Replace "prepareforu.app" with your actual domain if different.
        Also register the same domain in Supabase Dashboard →
        Authentication → URL Configuration → Redirect URLs.
      -->
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data
          android:scheme="https"
          android:host="prepareforu.app"/>
      </intent-filter>

      <!--
        Custom scheme fallback for Supabase Auth callbacks.
        Supabase emailRedirectTo uses window.location.origin which in
        Capacitor resolves to https://localhost — but the deep link above
        handles the production flow. This scheme handles dev/test flows.
      -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data
          android:scheme="com.prepareforu.app"
          android:host="callback"/>
      </intent-filter>

    </activity>

    <!--
      FileProvider — required by Capacitor for file sharing between the
      WebView and native Android (e.g. camera, file picker plugins).
      android:exported="false" — only this app can access it.
      android:grantUriPermissions="true" — allows temporary URI grants
      to other apps (e.g. sharing a file with another app).
    -->
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/file_paths"/>
    </provider>

  </application>

</manifest>
