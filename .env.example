# ─── Supabase Configuration ──────────────────────────────────────────────────
# Create a project at https://supabase.com
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Security ────────────────────────────────────────────────────────────────
# Set to 'true' to use local Supabase containers (Auth, DB, etc.)
VITE_USE_SUPABASE_LOCAL=false

# Cloudflare Turnstile CAPTCHA (Required for Auth endpoints)
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key-here

# ─── Advanced ────────────────────────────────────────────────────────────────
# Unique request ID suffix for idempotency testing
VITE_DEV_REQUEST_SUFFIX=local_dev
